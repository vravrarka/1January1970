{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Gateway": {
    "HttpPort": 8080,
    "HttpsPort": 8443,
    "LoginPermitPerMinute": 10,
    "Certificate": {
      "Path": "/https/gateway.pfx"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "auth-login": {
        "ClusterId": "auth",
        "Order": 1,
        "RateLimiterPolicy": "login",
        "Match": { "Path": "/auth/login", "Methods": [ "POST" ] }
      },
      "auth": {
        "ClusterId": "auth",
        "Order": 10,
        "Match": { "Path": "/auth/{**rest}" }
      },
      "users": {
        "ClusterId": "auth",
        "Order": 10,
        "Match": { "Path": "/users/{**rest}" }
      },
      "device-return": {
        "ClusterId": "requests",
        "Order": 1,
        "Match": { "Path": "/devices/{deviceId}/return", "Methods": [ "PATCH" ] }
      },
      "devices": {
        "ClusterId": "devices",
        "Order": 10,
        "Match": { "Path": "/devices/{**rest}" }
      },
      "device-types": {
        "ClusterId": "devices",
        "Order": 10,
        "Match": { "Path": "/device-types" }
      },
      "requests": {
        "ClusterId": "requests",
        "Order": 10,
        "Match": { "Path": "/requests/{**rest}" }
      },
      "audit": {
        "ClusterId": "audit",
        "Order": 10,
        "Match": { "Path": "/audit/{**rest}" }
      }
    },
    "Clusters": {
      "auth": {
        "Destinations": { "primary": { "Address": "http://auth-service:8080/" } }
      },
      "devices": {
        "Destinations": { "primary": { "Address": "http://device-service:8080/" } }
      },
      "requests": {
        "Destinations": { "primary": { "Address": "http://request-service:8080/" } }
      },
      "audit": {
        "Destinations": { "primary": { "Address": "http://audit-service:8080/" } }
      }
    }
  }
}
