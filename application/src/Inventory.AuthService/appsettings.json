{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "school-inventory",
    "Audience": "school-inventory-api",
    "AccessTokenMinutes": 30
  },
  "LoginProtection": {
    "WarningThreshold": 3,
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15
  },
  "Services": {
    "DeviceService": "http://device-service:8080/"
  },
  "Kafka": {
    "Enabled": true,
    "BootstrapServers": "kafka:9092",
    "AuditTopic": "audit-events"
  },
  "WorkingHours": {
    "TimeZone": "Europe/Moscow",
    "StartHour": 8,
    "EndHour": 18,
    "WorkDays": "Mon,Tue,Wed,Thu,Fri"
  }
}
