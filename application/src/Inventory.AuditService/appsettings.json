{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "school-inventory",
    "Audience": "school-inventory-api"
  },
  "Kafka": {
    "Enabled": true,
    "BootstrapServers": "kafka:9092",
    "AuditTopic": "audit-events",
    "ConsumerGroup": "audit-service"
  },
  "WorkingHours": {
    "TimeZone": "Europe/Moscow",
    "StartHour": 8,
    "EndHour": 18,
    "WorkDays": "Mon,Tue,Wed,Thu,Fri"
  }
}
