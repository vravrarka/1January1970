# Скопируйте этот файл в .env и замените значения. Файл .env не коммитится.

# --- PostgreSQL: суперпользователь и отдельные пользователи сервисов ---
POSTGRES_PASSWORD=change-me-postgres
AUTH_DB_PASSWORD=change-me-auth
DEVICE_DB_PASSWORD=change-me-device
REQUEST_DB_PASSWORD=change-me-request
AUDIT_DB_PASSWORD=change-me-audit

# --- JWT: ключ подписи токенов, не короче 32 символов ---
JWT_SIGNING_KEY=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TOKEN_MINUTES=30

# --- Первый администратор (создаётся при первом запуске) ---
ADMIN_LOGIN=admin
ADMIN_PASSWORD=Admin!2026change

# --- Демонстрационные данные: teacher01, student01, student02 и 8 устройств ---
# Для реальной эксплуатации установите false.
SEED_DEMO_DATA=true
DEMO_PASSWORD=Demo!2026pass

# --- Kafka: false = события аудита остаются только в локальных журналах сервисов ---
KAFKA_ENABLED=true

# --- Учебное время: действия вне его помечаются в аудите предупреждением ---
WORK_TIMEZONE=Europe/Moscow
WORK_START_HOUR=8
WORK_END_HOUR=18
WORK_DAYS=Mon,Tue,Wed,Thu,Fri

# --- Порты шлюза на хосте и пароль PFX-сертификата ---
HTTPS_PORT=8443
HTTP_PORT=8080
CERT_PASSWORD=change-me-cert
